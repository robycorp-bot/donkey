{
  "name": "coder-mega-brain",
  "private": true,
  "version": "0.2.0",
  "description": "Um editor pessoal, leve e cheio de ideia.",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420 --strictPort",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 1420",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build",
    "tauri": "tauri",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml --lib",
    "test:e2e": "playwright test",
    "test:all": "npm run check && npm run test:coverage && npm run test:rust && npm run build && npm run test:e2e"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.10.1",
    "monaco-editor": "^0.57.0",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.57.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tauri-apps/cli": "^2.12.3",
    "@testing-library/svelte": "^5.4.2",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^5.0.5",
    "jsdom": "^30.1.3",
    "svelte-check": "^4.4.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22.12"
  },
  "overrides": {
    "dompurify": "^3.4.17"
  }
}
