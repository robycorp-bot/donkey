{
  "mcpServers": {
    "hostinger-deploy": {
      "command": "python",
      "args": ["mcp/hostinger-deploy/server.py"],
      "env": {
        "HOSTINGER_FTP_HOST": "${HOSTINGER_FTP_HOST}",
        "HOSTINGER_FTP_USER": "${HOSTINGER_FTP_USER}",
        "HOSTINGER_FTP_PASSWORD": "${HOSTINGER_FTP_PASSWORD}",
        "HOSTINGER_STAGING_PATH": "${HOSTINGER_STAGING_PATH}",
        "HOSTINGER_PRODUCTION_PATH": "${HOSTINGER_PRODUCTION_PATH}",
        "DEPLOY_APPROVAL_TOKEN": "${DEPLOY_APPROVAL_TOKEN}"
      }
    }
  }
}
