# Copie para .env (ignorado pelo Git) e preencha. NUNCA versione valores reais.
HOSTINGER_FTP_HOST=ftp.seudominio.com
HOSTINGER_FTP_USER=conta_ftp_restrita
HOSTINGER_FTP_PASSWORD=
# Caminhos remotos dentro da conta FTP restrita
HOSTINGER_STAGING_PATH=/domains/staging.seudominio.com/public_html
HOSTINGER_PRODUCTION_PATH=/domains/seudominio.com/public_html
# Artefato local a publicar
DEPLOY_ARTIFACT_DIR=dist
# Token só emitido após aprovação do CTO Agent e do humano
DEPLOY_APPROVAL_TOKEN=
